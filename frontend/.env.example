# App URL (frontend)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Carevya backend (single base URL for waitlist, auth, etc.)
NEXT_PUBLIC_BACKEND_API_URL=https://carevya-backend.onrender.com

# Only needed if running Better Auth on this Next.js app (local SQLite mode)
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
