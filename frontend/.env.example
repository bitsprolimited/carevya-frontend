# App URL (frontend)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth client → Carevya backend
# https://better-auth.com/docs/concepts/client
NEXT_PUBLIC_BETTER_AUTH_URL=https://carevya-backend.onrender.com

# Waitlist upstream (server-only; used by Next.js /api/waitlist* routes)
WAITLIST_API_URL=https://carevya-backend.onrender.com/waitlist
WAITLIST_STATS_API_URL=https://carevya-backend.onrender.com/waitlist/stats

# Only needed if running Better Auth on this Next.js app (local SQLite mode)
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
